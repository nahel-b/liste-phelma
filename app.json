{
  "expo": {
    "name": "liste-phelma",
    "slug": "liste-phelma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
              "./App/assets/fonts/Inter-Black.ttf",
              "./App/assets/fonts/Inter-Bold.ttf",
              "./App/assets/fonts/Inter-ExtraBold.ttf",
              "./App/assets/fonts/Inter-Light.ttf",
              "./App/assets/fonts/Inter-Medium.ttf",
              "./App/assets/fonts/Inter-Regular.ttf",
              "./App/assets/fonts/Inter-SemiBold.ttf",
              "./App/assets/fonts/Inter-Thin.ttf",
              "./App/assets/fonts/Inter-ExtraLight.ttf",
              "./App/assets/fonts/Jungle-View.ttf",
              "./App/assets/fonts/Jungle-Regular.otf"
            ]
        }]
    ]
  }
}
